# 環境設定（プロジェクトID・ドメイン等の個人情報を含む）
.env
terraform.tfvars

# Terraform（.terraform.lock.hcl はコミット対象のため除外しない）
terraform/.terraform/
terraform/terraform.tfstate
terraform/terraform.tfstate.backup

# スクリプトが生成するログファイル
billing_role_update_log_*.txt

# 利用者向けスライド資料
# 生成元の gen.js と依存定義は追跡し、依存の実体と生成物は除外する
slides_build/node_modules/
slides_build/*.pptx

# 配布用スライド（編集を加えた成果物のため個別管理）
billing-role-sync_user_guide.pptx

# 個人用メモ
mail_template.md
mail_template_prompt.md
todo.md
.DS_Store
